# Development only. Copy to .env, generate your own key, then source it.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production requires DEBUG=false, HTTPS, and PostgreSQL.
# DATABASE_URL=postgresql://user:password@database:5432/salam_manis
DB_SSLMODE=verify-full
DASHBOARD_URL=
TELEGRAM_BOT_TOKEN=
# Safe default: simulation never sends real notifications.
NOTIFICATION_MODE=simulation
NOTIFICATION_CHANNEL=bot
# Optional institutional account. Never commit the session.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
STALE_DAYS=7
